-- =========================================================
-- 25. Función RPC: insert_movimiento_espontaneo_rpc
-- Wrapper RPC que parsea JSON y llama a la función base
-- =========================================================
CREATE OR REPLACE FUNCTION public.insert_movimiento_espontaneo_rpc(
    p_json jsonb
)
RETURNS SETOF public.movimiento_espontaneo
LANGUAGE plpgsql
AS $$
declare
  v_correo text := coalesce(p_json->>'p_correo_cuenta', p_json->>'correo_cuenta');
  v_contador int := (coalesce(p_json->>'p_contador', p_json->>'contador'))::int;
  v_fecha date := (coalesce(p_json->>'p_fecha_operacion', p_json->>'fecha_operacion'))::date;
  v_motivo text := coalesce(p_json->>'p_motivo', p_json->>'motivo');
  v_tipo_text text := coalesce(p_json->>'p_tipo', p_json->>'tipo');
  v_tipo boolean := case lower(coalesce(v_tipo_text, '')) when 'true' then true when 'false' then false else null end;
  v_monto numeric := (coalesce(p_json->>'p_monto', p_json->>'monto'))::numeric;
begin
  return query
  select * from public.insert_movimiento_espontaneo(
    v_correo,
    v_contador,
    v_fecha,
    v_motivo,
    v_tipo,
    v_monto
  );
end;
$$;
