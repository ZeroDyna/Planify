-- =========================================================
-- 13. Función RPC: login_user_validate
-- Verifica las credenciales de un usuario
-- =========================================================
CREATE OR REPLACE FUNCTION public.login_user_validate(
    p_correo text,
    p_password text
)
RETURNS boolean
LANGUAGE plpgsql
AS $$
DECLARE
    v_password_stored varchar;
BEGIN
    -- 1. Intenta obtener la contraseña del usuario
    SELECT contrasena INTO v_password_stored
    FROM public.usuario
    WHERE correo = p_correo;
    
    -- 2. Si no se encontró el correo, retorna falso
    IF NOT FOUND THEN
        RETURN false;
    END IF;
    
    -- 3. Compara la contraseña almacenada con la contraseña proporcionada
    RETURN (v_password_stored = p_password);
END;
$$;

-- =========================================================
-- 14. Función RPC: signup_user_and_account
-- Registra un nuevo usuario y crea su cuenta asociada
-- =========================================================
CREATE OR REPLACE FUNCTION public.signup_user_and_account(
    p_correo text,
    p_nombre_usuario text,
    p_password text
)
RETURNS boolean
LANGUAGE plpgsql
AS $$
BEGIN
    -- Verificar si el correo ya existe en usuario
    IF EXISTS(SELECT 1 FROM public.usuario WHERE correo = p_correo) THEN
        RETURN false;
    END IF;
    
    -- Verificar si el correo ya existe como correo_cuenta (para prevenir duplicidad)
    IF EXISTS(SELECT 1 FROM public.cuenta WHERE correo_cuenta = p_correo) THEN
        RETURN false;
    END IF;
    
    -- Insertar usuario
    INSERT INTO public.usuario (correo, nombre_usuario, contrasena)
    VALUES (p_correo, p_nombre_usuario, p_password);
    
    -- Insertar cuenta
    INSERT INTO public.cuenta (correo_cuenta, fecha_creacion, activo, nombre_cuenta, correo_usuario)
    VALUES (
        p_correo,
        CURRENT_DATE,
        true,
        'Cuenta de ' || p_nombre_usuario,
        p_correo
    );
    
    RETURN true;
    
EXCEPTION
    WHEN OTHERS THEN
        -- Captura cualquier otro error de inserción
        RETURN false;
END;
$$;

