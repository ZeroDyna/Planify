-- =========================================================
-- 1. Función RPC: check_email_registered
-- Verifica si un correo existe en la tabla usuario
-- =========================================================
CREATE OR REPLACE FUNCTION public.check_email_registered(
    p_email text
)
RETURNS boolean
LANGUAGE plpgsql
AS $$
DECLARE
    v_exists boolean;
BEGIN
    -- Busca si existe alguna fila en la tabla usuario con el correo dado
    SELECT EXISTS(SELECT 1 FROM usuario WHERE correo = p_email) INTO v_exists;
    RETURN v_exists;
END;
$$;

