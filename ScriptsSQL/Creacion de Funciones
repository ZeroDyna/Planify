-- =========================================================
-- 20. Función RPC: update_user_account_data
-- Actualiza la información del usuario y/o la cuenta asociada
-- =========================================================
CREATE OR REPLACE FUNCTION public.update_user_account_data(
    p_email text,
    p_nombre_usuario text default NULL,
    p_ubicacion text default NULL,
    p_lugar_trabajo text default NULL,
    p_nombre_cuenta text default NULL
)
RETURNS SETOF public.get_user_account_data
LANGUAGE plpgsql
AS $$
BEGIN
    -- Actualizar usuario si hay datos (COALESCE mantiene el valor antiguo si el nuevo es NULL)
    IF p_nombre_usuario IS NOT NULL OR p_ubicacion IS NOT NULL OR p_lugar_trabajo IS NOT NULL THEN
        UPDATE public.usuario
        SET 
            nombre_usuario = COALESCE(p_nombre_usuario, public.usuario.nombre_usuario),
            ubicacion = COALESCE(p_ubicacion, public.usuario.ubicacion),
            lugar_trabajo = COALESCE(p_lugar_trabajo, public.usuario.lugar_trabajo)
        WHERE public.usuario.correo = p_email;
    END IF;
    
    -- Actualizar cuenta si hay datos
    IF p_nombre_cuenta IS NOT NULL THEN
        UPDATE public.cuenta
        SET nombre_cuenta = p_nombre_cuenta
        WHERE public.cuenta.correo_usuario = p_email;
    END IF;
    
    -- Retornar datos actualizados usando la función de consulta
    RETURN QUERY
    SELECT * FROM public.get_user_account_data(p_email);
END;
$$;

-- =========================================================
-- 21. Función RPC: update_user_password
-- Actualiza la contraseña de un usuario existente
-- =========================================================
CREATE OR REPLACE FUNCTION public.update_user_password(
    p_correo text,
    p_nueva_contrasena text
)
RETURNS boolean
LANGUAGE plpgsql
AS $$
BEGIN
    -- Verificar si el usuario existe
    IF NOT EXISTS(SELECT 1 FROM public.usuario WHERE correo = p_correo) THEN
        RETURN false;
    END IF;
    
    -- Actualizar contraseña
    UPDATE public.usuario
    SET contrasena = p_nueva_contrasena
    WHERE correo = p_correo;
    
    RETURN true;
    
EXCEPTION
    WHEN OTHERS THEN
        RETURN false;
END;
$$;

