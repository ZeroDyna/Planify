-- =========================================================
-- 7. Función RPC: get_movements_range
-- Retorna todos los movimientos (concepto y espontáneo) dentro de un rango de fechas
-- =========================================================
CREATE OR REPLACE FUNCTION public.get_movements_range(
    correo text,      -- Correo de la cuenta
    start_date date,  -- Fecha de inicio
    end_date date     -- Fecha de fin
)
RETURNS TABLE (
    fecha date,
    nombre_movimiento text,
    tipo boolean,
    monto numeric,
    correo_cuenta text,
    source_table text,
    id bigint
)
LANGUAGE sql
AS $$
  select *
  from (
    -- Movimientos por Concepto
    select
      mc.fecha_operacion::date as fecha,
      coalesce(c.nombre_concepto, 'Concepto') as nombre_movimiento,
      (c.tipo)::boolean as tipo,
      mc.monto::numeric as monto,
      mc.correo_cuenta,
      'concepto'::text as source_table,
      mc.id_movimiento_concepto::bigint as id
    from public.movimiento_concepto mc
    left join public.concepto c on c.id_concepto = mc.id_concepto
    where mc.correo_cuenta = correo
      and mc.fecha_operacion between start_date and end_date

    union all

    -- Movimientos Espontáneos
    select
      me.fecha_operacion::date as fecha,
      coalesce(me.motivo, 'Sin motivo') as nombre_movimiento,
      (me.tipo)::boolean as tipo,
      me.monto::numeric as monto,
      me.correo_cuenta,
      'espontaneo'::text as source_table,
      me.id_movimiento_espontaneo::bigint as id
    from public.movimiento_espontaneo me
    where me.correo_cuenta = correo
      and me.fecha_operacion between start_date and end_date
  ) t
  order by fecha;
$$;

